# ====================================================================
# Email Notification Settings for Internship Portal
# ====================================================================
# To send emails via Gmail:
# 1. Enter your Gmail address in EMAIL_HOST_USER
# 2. Generate a 16-character App Password:
#    - Go to Google Account (myaccount.google.com)
#    - Security -> 2-Step Verification -> App Passwords
#    - Create an App Password for 'Internship Portal'
#    - Paste the 16-character password below in EMAIL_HOST_PASSWORD (without spaces)
# ====================================================================

EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=your_email@gmail.com
